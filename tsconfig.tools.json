{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tools.tsbuildinfo",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "vitest.config.ts",
    "playwright.config.ts",
    "scripts/**/*.ts",
    "e2e/**/*.ts",
    "apps/api/drizzle.config.ts"
  ]
}
