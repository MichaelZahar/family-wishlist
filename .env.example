# Скопируйте в .env: cp .env.example .env
# Переопределения под git worktree (БД wishlist_<branch>, порты) — в .env.local, см. docs/adr.md, ADR-006.

# Postgres в Docker Compose (только локально)
POSTGRES_USER=wishlist
POSTGRES_PASSWORD=wishlist
POSTGRES_DB=wishlist
POSTGRES_PORT=5432

# Подключение приложения к БД
DATABASE_URL=postgres://wishlist:wishlist@127.0.0.1:5432/wishlist
DATABASE_URL_TEST=postgres://wishlist:wishlist@127.0.0.1:5432/wishlist_test

# Порты dev-серверов
API_PORT=3000
WEB_PORT=5173

# Публичный адрес приложения (ADR-002)
APP_URL=http://localhost:5173

# Секрет Better Auth (ADR-003). Сгенерировать: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
