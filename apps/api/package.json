{
  "name": "@family-wishlist/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@family-wishlist/source --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/server.ts",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local dist/server.js",
    "db:migrate": "tsx --conditions=@family-wishlist/source --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/db/migrate-cli.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@family-wishlist/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  }
}
